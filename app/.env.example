# Copy this file to .env (next to main.py) and fill in what you use. Keep .env private: never commit it.

# Hosted providers (you need at least one of these, or use Ollama/Custom below)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Local models with Ollama: no key needed. Setting OLLAMA_MODEL also lets auto-switch fall back to it.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp server, a gateway...)
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
